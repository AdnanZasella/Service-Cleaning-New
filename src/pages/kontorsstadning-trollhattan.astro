      { name: 'Arbetsplatser', rows: ['Skrivbord och ytor torkas av', 'Papperskorgar töms', 'Golv dammsugs och moppas'] },
      { name: 'Pentry och fikarum', rows: ['Bänkar, diskbänk och blandare rengörs', 'Kyl och micro torkas av utvändigt', 'Golv tvättas'] },
