---
import { Image } from 'astro:assets';
interface Room { name: string; rows: string[]; }
interface Props {
  heading: string;
  intro: string;
  rooms: Room[];
  photo?: ImageMetadata;
  photoAlt?: string;
  more?: { href: string; label: string };
}
const { heading, intro, rooms, photo, photoAlt = '', more } = Astro.props;
---
<section class="incl" aria-labelledby="h-incl">
  <div class="wrap incl__in">
    <div class="incl__head">
      <h2 id="h-incl">{heading}</h2>
      <p>{intro}</p>
      {more && <a class="more" href={more.href}>{more.label} <svg width="18" height="18" aria-hidden="true"><use href="#i-arrow" /></svg></a>}
      {photo && <Image class="incl__photo" src={photo} width={900} height={560} widths={[480, 720, 900]} sizes="(min-width: 56rem) 28rem, 100vw" loading="lazy" alt={photoAlt} />}
    </div>
    <div class="incl__rooms">
      {rooms.map((r) => (
        <section class="room">
          <h3>{r.name}</h3>
          <ul>
            {r.rows.map((row) => (
              <li><svg width="22" height="22" aria-hidden="true"><use href="#i-check" /></svg><span>{row}</span></li>
            ))}
          </ul>
        </section>
      ))}
      <div class="stamp" aria-hidden="true">
        <svg viewBox="0 0 220 84" width="220" height="84"><rect x="3" y="3" width="214" height="78" fill="none" stroke="currentColor" stroke-width="4" rx="3"/><rect x="10" y="10" width="200" height="64" fill="none" stroke="currentColor" stroke-width="1.5"/><text x="110" y="54" text-anchor="middle" font-family="Archivo Variable, Archivo, sans-serif" font-weight="800" font-size="34" letter-spacing="3" fill="currentColor">UTFÖRT</text></svg>
      </div>
    </div>
  </div>
</section>
<style is:global>
  .incl { background: var(--tint); padding-block: var(--space-6); }
  .incl__in { display: grid; gap: var(--space-5); }
  .incl__head { display: grid; gap: var(--space-3); align-content: start; }
  .more { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 700; min-height: 2.75rem; }
  .incl__rooms { display: grid; gap: var(--space-4); }
  .room { border-top: var(--line); padding-top: var(--space-3); }
  .room h3 { margin-bottom: var(--space-3); }
  .room li { display: grid; grid-template-columns: 1.4rem 1fr; gap: var(--space-2); padding-block: var(--space-2); border-bottom: 1px solid var(--tint-rule); align-items: start; }
  .room li svg { margin-top: 0.15rem; }
  .incl__photo { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border: var(--line); margin-top: var(--space-3); }
  .stamp { grid-column: 1 / -1; color: var(--ink); transform: rotate(-4deg); width: max-content; margin-top: var(--space-3); opacity: 0.9; }
  @supports (animation-timeline: view()) {
    .room li svg { animation: tick-in linear both; animation-timeline: view(); animation-range: entry 10% entry 70%; }
    @keyframes tick-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  }
  @media (min-width: 56rem) {
    .incl__in { grid-template-columns: 1fr 2.2fr; gap: var(--space-6); }
    .incl__head { position: sticky; top: 6rem; align-self: start; }
    .incl__rooms { grid-template-columns: 1fr 1fr; }
    .room:last-of-type:nth-of-type(odd) { grid-column: 1 / -1; }
  }
</style>
