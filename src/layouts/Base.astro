---
import '@fontsource-variable/archivo';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { getImage } from 'astro:assets';
import { site } from '../config/site';
import ogSource from '../assets/tom-lagenhet-flyttstad-trollhattan.jpg';

interface Props { title: string; description: string; path?: string; noindex?: boolean; schema?: object[]; }
const { title, description, path = '/', noindex = false, schema = [] } = Astro.props;
const og = await getImage({ src: ogSource, width: 1200, height: 630, format: 'jpg' });
const ogUrl = new URL(og.src, site.url).href;
const canonical = new URL(path.endsWith("/") ? path : path + "/", site.url).href;
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#14202b" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#innehall">Hoppa till innehållet</a>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="i-check" viewBox="0 0 24 24"><rect x="2.75" y="2.75" width="18.5" height="18.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M6.5 12.5l4 4 7-9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square"/></symbol>
      <symbol id="i-phone" viewBox="0 0 24 24"><path d="M6.6 3h3l1.4 4.2-2 1.4a12 12 0 0 0 5.4 5.4l1.4-2L20 13.4v3A2.6 2.6 0 0 1 17.4 19 14.4 14.4 0 0 1 5 6.6 2.6 2.6 0 0 1 6.6 3z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></symbol>
      <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"/></symbol>
    </svg>
    <Header />
    <main id="innehall"><slot /></main>
    <Footer />
    <MobileBar />
  </body>
</html>
