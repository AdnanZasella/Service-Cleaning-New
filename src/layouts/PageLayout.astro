---
import Base from './Base.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  name: string;            // breadcrumb label
  intro?: string;
  noindex?: boolean;
  schema?: object[];
}
const { title, description, path, h1, name, intro, noindex, schema = [] } = Astro.props;
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Start', item: new URL('/', site.url).href },
    { '@type': 'ListItem', position: 2, name, item: new URL(path.endsWith('/') ? path : path + '/', site.url).href },
  ],
};
---
<Base title={title} description={description} path={path} noindex={noindex} schema={[...schema, crumbs]}>
  <header class="ph">
    <div class="wrap">
      <nav class="ph__crumbs" aria-label="Brödsmulor">
        <ol><li><a href="/">Start</a></li><li><span aria-current="page">{name}</span></li></ol>
      </nav>
      <h1>{h1}</h1>
      {intro && <p class="ph__intro">{intro}</p>}
    </div>
  </header>
  <div class="wrap prose">
    <slot />
  </div>
  <slot name="after" />
</Base>

<style>
  .ph { background: var(--ink); color: var(--paper); padding-block: var(--space-5) var(--space-6); }
  .ph__crumbs ol { display: flex; gap: 0.5rem; font-size: var(--step--1); margin-bottom: var(--space-3); }
  .ph__crumbs li { display: flex; align-items: center; }
  .ph__crumbs li + li::before { content: '›'; margin-right: 0.5rem; opacity: 0.7; }
  .ph__crumbs a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--ink-mist); }
  .ph h1 { font-size: clamp(2.25rem, 1.6rem + 4vw, 4.5rem); }
  .ph__intro { margin-top: var(--space-3); font-size: var(--step-1); color: var(--ink-mist); max-width: 44ch; }
  .prose { padding-block: var(--space-6); display: grid; gap: var(--space-4); }
  .prose :global(li a), .prose :global(p a) { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .prose :global(h2) { margin-top: var(--space-4); }
  .prose :global(h3) { margin-top: var(--space-3); }
  .prose :global(ul) { display: grid; gap: var(--space-1); padding-left: 1.25rem; list-style: disc; max-width: 68ch; }
  .prose :global(ul.plain) { list-style: none; padding: 0; gap: 0; border-top: var(--line); max-width: 36rem; }
  .prose :global(ul.plain li) { border-bottom: var(--hair); }
  @media (min-width: 48rem) { .prose :global(.contact ul) { display: flex; gap: var(--space-5); } }
  .prose :global(.contact) { display: grid; gap: var(--space-2); border-top: var(--line); padding-top: var(--space-3); }
  .prose :global(.contact ul) { list-style: none; padding: 0; gap: 0; }
  .prose :global(.contact li a) { display: inline-flex; align-items: center; min-height: 2.75rem; font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); }
</style>
